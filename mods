#!/usr/bin/env python3
"""Turn Claude Code mods on or off for every new session.

  mods                 list mods and whether they're on
  mods on <name|all>   load it in every new session
  mods off <name|all>  stop loading it

Works by editing CLAUDE_CODE_PLUGIN_DIRS in ~/.claude/settings.json.
Changes apply to sessions started after you run it.
"""
import json, os, sys

HOME = os.path.expanduser('~')
MODS = os.path.join(HOME, '.claude', 'mods')
SETTINGS = os.path.join(HOME, '.claude', 'settings.json')
KEY = 'CLAUDE_CODE_PLUGIN_DIRS'

def available():
    return sorted(d for d in os.listdir(MODS) if os.path.isfile(os.path.join(MODS, d, '.claude-plugin', 'plugin.json')))

def load():
    with open(SETTINGS) as f:
        return json.load(f)

def enabled(settings):
    raw = settings.get('env', {}).get(KEY, '')
    return [p for p in raw.split(':') if p]

def save(settings, dirs):
    env = settings.setdefault('env', {})
    if dirs:
        env[KEY] = ':'.join(dirs)
    else:
        env.pop(KEY, None)
    tmp = SETTINGS + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(settings, f, indent=2)
        f.write('\n')
    os.replace(tmp, SETTINGS)

def main(args):
    settings = load()
    dirs = enabled(settings)
    names = available()
    if not args:
        for n in names:
            print(('on ' if os.path.join(MODS, n) in dirs else 'off') + '  ' + n)
        return
    if len(args) != 2 or args[0] not in ('on', 'off'):
        print(__doc__.strip()); sys.exit(1)
    targets = names if args[1] == 'all' else [args[1]]
    for n in targets:
        if n not in names:
            print(f'no mod named {n}'); sys.exit(1)
        path = os.path.join(MODS, n)
        if args[0] == 'on' and path not in dirs:
            dirs.append(path)
        if args[0] == 'off' and path in dirs:
            dirs.remove(path)
    save(settings, dirs)
    print(f"{args[0]}: {', '.join(targets)} (new sessions)")

main(sys.argv[1:])
